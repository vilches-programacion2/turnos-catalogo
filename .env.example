# Copiar a .env para Docker Compose y reemplazar la clave local.
DB_USER=catalogo
DB_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_LOCAL
DB_NAME=catalogo
DB_PORT=5434
APP_PORT=8082
APP_LOG_LEVEL=INFO
# UID/GID del dueño del archivo secreto (obtener con id -u / id -g).
# Usar un usuario sin privilegios. Por defecto, el contenedor utiliza 10001:10001.
APP_UID=
APP_GID=

# Solo para ejecutar Java en el host; Spring no lee .env automáticamente.
DB_URL=jdbc:postgresql://localhost:5434/catalogo

# Copiar únicamente la clave pública de reservas a ./secrets/public.pem.
# Para Java en el host, usar su ruta file: absoluta en JWT_PUBLIC_KEY.
JWT_PUBLIC_KEY=file:/run/secrets/public.pem
JWT_ISSUER=https://turnos-reservas.local
JWT_AUDIENCE=turnos-catalogo

# Completar con el acceso de cátedra (VPN). Nunca versionar los valores reales.
CATEDRA_ENABLED=true
CATEDRA_BASE_URL=
# Archivo con el JWT técnico, sin el prefijo Bearer. El mismo en ambos backends.
CATEDRA_TOKEN_SOURCE=./secrets/catedra.jwt
# Ruta dentro del contenedor; en el host usar la ruta local del archivo.
CATEDRA_TOKEN_FILE=/run/secrets/catedra.jwt
CATEDRA_CONNECT_TIMEOUT=3s
CATEDRA_READ_TIMEOUT=5s
