# Copiar a .env para Docker Compose y reemplazar la clave local.
DB_USER=catalogo
DB_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_LOCAL
DB_NAME=catalogo
DB_PORT=5434
APP_PORT=8082
APP_LOG_LEVEL=INFO

# Solo para ejecutar Java en el host; Spring no lee .env automáticamente.
DB_URL=jdbc:postgresql://localhost:5434/catalogo
